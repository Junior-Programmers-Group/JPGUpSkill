// Jenkins CI/CD pipeline for the Week 6 Laravel backend.
//
// The Jenkins agent runs on the Docker host (or with the host Docker socket
// mounted), so every `docker run` below creates a *sibling* container of the
// Jenkins agent itself - no Docker-in-Docker daemon is required.

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        IMAGE_TAG     = "jpgupskill/laravel-week6:${env.BUILD_NUMBER}"
        IMAGE_LATEST  = "jpgupskill/laravel-week6:latest"
        TEST_TAG      = "jpgupskill/laravel-week6:test"
        CONTAINER     = "laravel-week6-app"
        APP_PORT      = "15000"
        CONTAINER_PORT = "15000"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build test image') {
            steps {
                sh 'docker build --target test -t ${TEST_TAG} .'
            }
        }

        stage('Unit tests') {
            steps {
                sh 'docker run --rm ${TEST_TAG}'
            }
        }

        stage('Build production image') {
            steps {
                sh 'docker build --target runtime -t ${IMAGE_TAG} -t ${IMAGE_LATEST} .'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker rm -f ${CONTAINER} 2>/dev/null || true
                    docker run -d \
                        --name ${CONTAINER} \
                        --restart unless-stopped \
                        -p ${APP_PORT}:${CONTAINER_PORT} \
                        ${IMAGE_TAG}
                '''
            }
        }

        stage('Smoke test') {
            steps {
                sh '''
                    ok=0
                    for i in $(seq 1 30); do
                        if curl -fsSL "http://localhost:${APP_PORT}/" >/dev/null 2>&1; then
                            ok=1
                            break
                        fi
                        sleep 2
                    done
                    if [ "$ok" != "1" ]; then
                        echo "Smoke test failed: http://localhost:${APP_PORT}/ did not answer 200"
                        docker logs --tail 50 ${CONTAINER} || true
                        exit 1
                    fi
                    echo "Smoke test passed on port ${APP_PORT}"
                '''
            }
        }
    }

    post {
        failure {
            sh 'docker ps -a --filter name=${CONTAINER} --format "{{.Names}} {{.Status}}" || true'
        }
        always {
            sh 'docker image prune -f >/dev/null 2>&1 || true'
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}
